# ------------------------------------------------------------------
# AI Career Launchpad - environment configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit your real .env file to Git.
# ------------------------------------------------------------------

# Flask
# Generate a random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Set to 1 for local debugging only. Never enable in production.
FLASK_DEBUG=0

# Maximum resume upload size in megabytes
MAX_UPLOAD_MB=5

# ------------------------------------------------------------------
# AI provider: "mock" (offline/local dev) or "bedrock" (Amazon Bedrock)
# ------------------------------------------------------------------
AI_PROVIDER=mock

# ------------------------------------------------------------------
# Amazon Bedrock settings (only needed when AI_PROVIDER=bedrock)
# ------------------------------------------------------------------
AWS_REGION=us-east-1

# Pick a model you have access to in the Bedrock console.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MAX_TOKENS=2000
BEDROCK_TEMPERATURE=0.2

# ------------------------------------------------------------------
# AWS credentials
# LEAVE THESE BLANK IN MOST CASES.
# In production (App Runner / EC2 / ECS) credentials come from the
# IAM role attached to the compute resource.
#
# Only fill these in for local testing. Never commit real keys.
# ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=